# -------------------------------------------------------------
# Application Environment Settings
# -------------------------------------------------------------
PROJECT_NAME="Social Media Insight Service"
API_V1_STR="/api/v1"
ENVIRONMENT=development
SECRET_KEY=change_this_to_a_super_secret_key_in_production_32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
TOKEN_ENCRYPTION_KEY=  # Optional Fernet 32 url-safe base64 key (derived from SECRET_KEY if omitted)

FRONTEND_URL=http://localhost:3000
NGROK_BACKEND_URL=

# -------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=social_insight
POSTGRES_CONNECTIONS=100
# Async SQLAlchemy Database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@db:5432/social_insight

# -------------------------------------------------------------
# Redis (Cache, Rate Limiter & Celery Broker)
# -------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -------------------------------------------------------------
# AI Engine (Groq / Gemini / OpenAI)
# -------------------------------------------------------------
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_URL=https://api.groq.com/openai/v1

# -------------------------------------------------------------
# Social Media Platform Credentials
# -------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:5032/api/v1/platforms/youtube/callback

GOOGLE_AUTH_BASE_URL
GOOGLE_TOKEN_URL
YOUTUBE_API_BASE_URL

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:5032/api/v1/platforms/facebook/callback

THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://127.0.0.1:5032/api/v1/platforms/threads/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://xxxx.ngrok-free.app/api/v1/platforms/tiktok/callback
TIKTOK_AUTH_BASE_URL=https://www.tiktok.com/v2/auth/authorize/
TIKTOK_TOKEN_URL=https://open.tiktokapis.com/v2/oauth/token/
TIKTOK_API_BASE_URL=https://open.tiktokapis.com/v2
TIKTOK_WEBHOOK_SECRET=
